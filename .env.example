# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public contact addresses shown on /support, /security and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SECURITY_CONTACT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=
# Server-only direct Postgres connection (Supabase "connection string", pooler or direct).
# Used for transactional control-plane writes and the FLOW worker. RLS is still
# enforced for customer operations by switching to the `authenticated` role per transaction.
DATABASE_URL=
# Comma-separated owner emails. Checked server-side on every admin request,
# together with a verified Supabase session and a confirmed email.
ADMIN_EMAILS=
# Feature gates. Keep false until adapters pass acceptance (BUILD_INSTRUCTIONS.md §11).
BILLING_ENABLED=false
PROVISIONING_ENABLED=false
# HMAC secret for inbound payment webhooks (only used when billing is enabled).
PAYMENT_WEBHOOK_SECRET=
# Optional local model route (Ollama). Leave empty to mark the route not-configured.
OLLAMA_BASE_URL=
# PRFKT cell controller (docs/runtime/CELL_CONTROLLER.md). http is accepted only on
# loopback or the Tailscale range; the token is server-only.
PRFKT_CELL_CONTROLLER_URL=
PRFKT_CELL_CONTROLLER_TOKEN=
